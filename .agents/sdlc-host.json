{
	"schemaVersion": "1.3.0",
	"profileId": "default-host",
	"repositoryId": "agent-sdlc",
	"adapter": "default",
	"stateDir": "tools/.agent-sdlc",
	"reviewDir": "tools/.review",
	"specDraftDir": "docs/specs/drafts",
	"runsDir": "docs/specs/runs",
	"git": {
		"authorName": "agent-sdlc",
		"authorEmail": "agent@sdlc.local"
	},
	"workspace": {
		"allowedPathRoots": [
			"adapters",
			"cli",
			"docs",
			"execution",
			"host",
			"ledger",
			"persistence",
			"policy",
			"prompts",
			"review",
			"roles",
			"scripts",
			"testing",
			"tools",
			"workflow",
			".agents"
		]
	},
	"policy": {
		"highRiskPaths": [
			".github/workflows",
			"tools/quality"
		],
		"protectedBaselinePaths": [
			"tools/quality/baselines",
			"tools/quality/baseline",
			"tools/quality/reports"
		]
	},
	"qualityGate": {
		"eslintConfigPath": "tools/quality/eslint-gate.cjs",
		"baselinePath": "tools/quality/baselines/quality-v1.json",
		"exceptionsPath": "tools/quality/exceptions.json"
	},
	"learnings": {
		"filePath": ".learnings.jsonl",
		"scopes": [
			"global",
			"adapters",
			"cli",
			"execution",
			"host",
			"ledger",
			"persistence",
			"policy",
			"prompts",
			"review",
			"roles",
			"scripts",
			"testing",
			"workflow"
		],
		"scopeInference": [
			{
				"prefix": "adapters/",
				"scope": "adapters"
			},
			{
				"prefix": "cli/",
				"scope": "cli"
			},
			{
				"prefix": "execution/",
				"scope": "execution"
			},
			{
				"prefix": "host/",
				"scope": "host"
			},
			{
				"prefix": "ledger/",
				"scope": "ledger"
			},
			{
				"prefix": "persistence/",
				"scope": "persistence"
			},
			{
				"prefix": "policy/",
				"scope": "policy"
			},
			{
				"prefix": "prompts/",
				"scope": "prompts"
			},
			{
				"prefix": "review/",
				"scope": "review"
			},
			{
				"prefix": "roles/",
				"scope": "roles"
			},
			{
				"prefix": "scripts/",
				"scope": "scripts"
			},
			{
				"prefix": "testing/",
				"scope": "testing"
			},
			{
				"prefix": "workflow/",
				"scope": "workflow"
			}
		]
	},
	"verify": {
		"argv": [
			"pnpm",
			"run",
			"test:unit"
		]
	},
	"prompts": {
		"preset": "default",
		"roleAddendaDir": ".agents/workflows/prompts",
		"rubricAddendaDir": ".agents/review-rubrics",
		"pathScopedRules": []
	}
}
